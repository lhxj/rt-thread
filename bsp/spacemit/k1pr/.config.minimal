#
# RT-Thread Kernel Configuration (Minimal myk1 BSP)
#
CONFIG_RT_KLIBC_USING_VSNPRINTF_LONGLONG=y
CONFIG_RT_NAME_MAX=24
CONFIG_RT_USING_SMP=y
CONFIG_RT_CPUS_NR=8
CONFIG_RT_ALIGN_SIZE=8
CONFIG_RT_THREAD_PRIORITY_32=y
CONFIG_RT_THREAD_PRIORITY_MAX=32
CONFIG_RT_TICK_PER_SECOND=100
CONFIG_RT_USING_OVERFLOW_CHECK=y
CONFIG_RT_USING_HOOK=y
CONFIG_RT_HOOK_USING_FUNC_PTR=y
CONFIG_RT_USING_IDLE_HOOK=y
CONFIG_RT_IDLE_HOOK_LIST_SIZE=4
CONFIG_IDLE_THREAD_STACK_SIZE=16384
CONFIG_SYSTEM_THREAD_STACK_SIZE=16384
CONFIG_RT_USING_TIMER_SOFT=y
CONFIG_RT_TIMER_THREAD_PRIO=4
CONFIG_RT_TIMER_THREAD_STACK_SIZE=16384
CONFIG_RT_USING_CPU_USAGE_TRACER=y
CONFIG_RT_USING_DEBUG=y
CONFIG_RT_DEBUGING_ASSERT=y
CONFIG_RT_DEBUGING_COLOR=y
CONFIG_RT_DEBUGING_CONTEXT=y
CONFIG_RT_DEBUGING_AUTO_INIT=y

#
# Inter-Thread communication
#
CONFIG_RT_USING_SEMAPHORE=y
CONFIG_RT_USING_MUTEX=y
CONFIG_RT_USING_EVENT=y
CONFIG_RT_USING_MAILBOX=y
CONFIG_RT_USING_MESSAGEQUEUE=y
CONFIG_RT_USING_SIGNALS=y

#
# Memory Management
#
CONFIG_RT_USING_MEMPOOL=y
CONFIG_RT_USING_SLAB=y
CONFIG_RT_USING_MEMHEAP=y
CONFIG_RT_MEMHEAP_FAST_MODE=y
CONFIG_RT_USING_SLAB_AS_HEAP=y
CONFIG_RT_USING_MEMTRACE=y
CONFIG_RT_USING_HEAP=y

#
# Architecture Configuration
#
CONFIG_ARCH_CPU_64BIT=y
CONFIG_RT_USING_CACHE=y
CONFIG_ARCH_MM_MMU=y
CONFIG_ARCH_RISCV=y
CONFIG_ARCH_USING_RISCV_COMMON64=y
CONFIG_ARCH_REMAP_KERNEL=y
CONFIG_ARCH_TEXT_OFFSET=0x200000
CONFIG_ARCH_RAM_OFFSET=0x3FE00000
CONFIG_ARCH_SECONDARY_CPU_STACK_SIZE=4096
CONFIG_ARCH_HEAP_SIZE=0x4000000
CONFIG_ARCH_INIT_PAGE_SIZE=0x400000
CONFIG_ARCH_RISCV_FPU=y
CONFIG_ARCH_USING_NEW_CTX_SWITCH=y
CONFIG_RT_USING_CPU_FFS=y
CONFIG_RT_USING_DEVICE_OPS=y
CONFIG_RT_USING_INTERRUPT_INFO=y
CONFIG_RT_USING_CONSOLE=y
CONFIG_RT_CONSOLEBUF_SIZE=256
CONFIG_RT_CONSOLE_DEVICE_NAME="uart0"
CONFIG_RT_VER_NUM=0x50201
CONFIG_RT_USING_STDC_ATOMIC=y
CONFIG_RT_BACKTRACE_LEVEL_MAX_NR=32

#
# RT-Thread Components
#
CONFIG_RT_USING_COMPONENTS_INIT=y
CONFIG_RT_USING_USER_MAIN=y
CONFIG_RT_MAIN_THREAD_STACK_SIZE=16384
CONFIG_RT_MAIN_THREAD_PRIORITY=10
CONFIG_RT_USING_MSH=y
CONFIG_RT_USING_FINSH=y
CONFIG_FINSH_USING_MSH=y
CONFIG_FINSH_THREAD_NAME="tshell"
CONFIG_FINSH_THREAD_PRIORITY=20
CONFIG_FINSH_THREAD_STACK_SIZE=16384
CONFIG_FINSH_USING_HISTORY=y
CONFIG_FINSH_HISTORY_LINES=10
CONFIG_FINSH_USING_SYMTAB=y
CONFIG_FINSH_CMD_SIZE=80
CONFIG_MSH_USING_BUILT_IN_COMMANDS=y
CONFIG_FINSH_USING_DESCRIPTION=y
CONFIG_FINSH_ARG_MAX=10
CONFIG_FINSH_USING_OPTION_COMPLETION=y

#
# DFS: Minimal device virtual file system (required by serial driver)
#
CONFIG_RT_USING_DFS=y
CONFIG_DFS_USING_POSIX=y
CONFIG_DFS_USING_WORKDIR=y
CONFIG_DFS_FD_MAX=32
CONFIG_RT_USING_DFS_V2=y
CONFIG_RT_USING_DFS_DEVFS=y
CONFIG_RT_USING_DFS_ROMFS=y

#
# Device Drivers (Minimal)
#
CONFIG_RT_USING_DM=y
CONFIG_RT_USING_DEVICE_IPC=y
CONFIG_RT_UNAMED_PIPE_NUMBER=64
CONFIG_RT_USING_SYSTEM_WORKQUEUE=y
CONFIG_RT_SYSTEM_WORKQUEUE_STACKSIZE=8192
CONFIG_RT_SYSTEM_WORKQUEUE_PRIORITY=23

#
# Serial Driver (for console output)
#
CONFIG_RT_USING_SERIAL=y
CONFIG_RT_USING_SERIAL_V1=y
CONFIG_RT_SERIAL_USING_DMA=y
CONFIG_RT_SERIAL_RB_BUFSZ=64
CONFIG_RT_SERIAL_8250=y
CONFIG_RT_SERIAL_PXA=y
CONFIG_RT_SERIAL_EARLY_SBI=y

#
# DMA Support (needed for Serial DMA)
#
CONFIG_RT_USING_DMA=y
CONFIG_RT_DMA_MMP_PDMA=y
CONFIG_RT_DMA_MMP_PDMA_SUPPORT_64BIT=y

#
# Basic Device Support
#
CONFIG_RT_USING_CPUTIME=y
CONFIG_RT_USING_CPUTIME_RISCV=y
CONFIG_CPUTIME_TIMER_FREQ=10000000
CONFIG_RT_USING_NULL=y
CONFIG_RT_USING_ZERO=y
CONFIG_RT_USING_RANDOM=y

#
# Interrupt Controller (PLIC)
#
CONFIG_RT_USING_PIC=y
CONFIG_MAX_HANDLERS=1024
CONFIG_RT_PIC_RISCV_INTC=y
CONFIG_RT_PIC_SIFIVE_PLIC=y

#
# DM Framework - Core Modules
#
CONFIG_RT_USING_PINCTRL=y
CONFIG_RT_USING_PIN=y
CONFIG_RT_PIN_K1X=y
CONFIG_RT_USING_KTIME=y
CONFIG_RT_USING_CLK=y
CONFIG_RT_CLK_SPACEMIT=y
CONFIG_RT_CLK_SPACEMIT_K1X=y
CONFIG_RT_USING_HWTIMER=y
CONFIG_RT_HWTIMER_SPACEMIT_K1X=y
CONFIG_RT_USING_RESET=y
CONFIG_RT_RESET_SPACEMIT_K1=y

#
# Power & Thermal (Minimal)
#
CONFIG_RT_PMDOMAIN_K1X=y
CONFIG_RT_USING_POWER_RESET=y
CONFIG_RT_POWER_RESET_REBOOT_SPACEMIT=y

#
# Device Tree & OFW
#
CONFIG_RT_USING_OFW=y
CONFIG_RT_FDT_EARLYCON_MSG_SIZE=128
CONFIG_RT_USING_OFW_BUS_RANGES_NUMBER=8

#
# POSIX Layer
#
CONFIG_RT_USING_POSIX_FS=y
CONFIG_RT_USING_POSIX_DEVIO=y
CONFIG_RT_USING_POSIX_STDIO=y
CONFIG_RT_USING_POSIX_POLL=y
CONFIG_RT_USING_POSIX_SELECT=y
CONFIG_RT_USING_POSIX_TERMIOS=y
CONFIG_RT_USING_POSIX_DELAY=y
CONFIG_RT_USING_POSIX_CLOCK=y
CONFIG_RT_USING_POSIX_TIMER=y

#
# Utilities
#
CONFIG_RT_USING_UTEST=y
CONFIG_UTEST_THR_STACK_SIZE=4096
CONFIG_UTEST_THR_PRIORITY=20
CONFIG_RT_USING_RESOURCE_ID=y
CONFIG_RT_USING_ADT=y
CONFIG_RT_USING_ADT_AVL=y
CONFIG_RT_USING_ADT_BITMAP=y
CONFIG_RT_USING_ADT_HASHMAP=y
CONFIG_RT_USING_ADT_REF=y

#
# Memory Management
#
CONFIG_RT_PAGE_MPR_SIZE_DYNAMIC=y
CONFIG_RT_PAGE_AFFINITY_BLOCK_SIZE=0x1000
CONFIG_RT_PAGE_MAX_ORDER=11
CONFIG_RT_USING_MEMBLOCK=y
CONFIG_RT_INIT_MEMORY_REGIONS=128

#
# SoC Specific
#
CONFIG_SOC_SPACEMIT_K1=y
CONFIG_RT_SOC_SPACEMIT_SOCINFO=y
